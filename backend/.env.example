# Puerto del servidor. Railway lo inyecta automáticamente; en local por defecto usa 4000.
PORT=4000

# Proyecto de Supabase (Postgres) donde se persisten todos los datos de la app.
# SUPABASE_URL: Project Settings -> API -> Project URL.
# SUPABASE_SERVICE_ROLE_KEY: Project Settings -> API -> "service_role" (clave secreta,
# NUNCA la "anon/public"). El backend necesita esta clave para leer/escribir saltando RLS.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Credenciales del usuario superadministrador. Se crean/actualizan automáticamente
# al arrancar el servidor (rol "superadmin", con acceso a Gestión de Usuarios).
ADMIN_USER=superadmin
ADMIN_PASS=CambiaEstaClave123

# Envío de correos (módulo "Email Envíos"), vía Microsoft Graph API.
# Se crean registrando una app en Azure AD (Entra ID) con permiso de aplicación
# "Mail.Send" sobre Microsoft Graph, con consentimiento de administrador.
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
# Casilla de correo (Microsoft 365) desde la que se envían los correos.
EMAIL_SENDER=ventas@tudominio.com
