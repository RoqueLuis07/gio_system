# Puerto del servidor. Railway lo inyecta automáticamente en producción.
PORT=4100

# Credenciales del panel de administración (se crean/actualizan al arrancar el servidor).
ADMIN_USER=admin
ADMIN_PASS=cambiar-esta-clave

# Si es "true", la raíz del dominio muestra directo el catálogo público
# (útil cuando este servicio tiene su propio dominio dedicado).
PUBLIC_ROOT=false
